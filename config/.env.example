# ApplyPilot configuration — copy to ~/.applypilot/.env and fill in
# Main LLM: Google Gemini (free tier works). Model defaults to gemini-3.5-flash
# (LLM_MODEL overrides it).
GEMINI_API_KEY=
# Fallback LLM: Claude API. Used automatically when Gemini is rate limited or out of
# quota (or as the main LLM if it's the only key). Model defaults to claude-haiku-5-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=medium            # low | medium | high | xhigh | max
# Or use your Claude Pro/Max subscription as the fallback instead (via the Claude Code
# CLI, logged in once with `claude`; no API credit needed):
# LLM_FALLBACK_PROVIDER=claude_cli   # CLAUDE_MODEL below picks the model (default haiku)
LLM_MODEL=
LLM_PROVIDER=
CLAUDE_MODEL=
# Optional: mirror ~/.applypilot/shortlist to Cloud Storage after each cycle
# APPLYPILOT_GCS_URI=gs://your-bucket/applypilot
# kie.ai (set LLM_PROVIDER=kie). LLM_MODEL is the main model; LLM_FALLBACK_MODEL is
# used when the main model hits a token/context/credit limit or keeps failing.
KIE_API_KEY=
# LLM_FALLBACK_MODEL=
# Optional per-stage models (kie only): LLM_SCORE_MODEL=, LLM_ENRICH_MODEL=
