# ApplyPilot configuration — copy to ~/.applypilot/.env and fill in
GEMINI_API_KEY=
LLM_MODEL=
LLM_PROVIDER=
CLAUDE_MODEL=
# Optional: mirror ~/.applypilot/shortlist to Cloud Storage after each cycle
# APPLYPILOT_GCS_URI=gs://your-bucket/applypilot
# kie.ai (set LLM_PROVIDER=kie). LLM_MODEL is the main model; LLM_FALLBACK_MODEL is
# used when the main model hits a token/context/credit limit or keeps failing.
KIE_API_KEY=
# LLM_FALLBACK_MODEL=
# Optional per-stage models (kie only): LLM_SCORE_MODEL=, LLM_ENRICH_MODEL=
