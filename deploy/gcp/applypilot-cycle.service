# Installed by deploy/gcp/setup.sh (placeholders __USER__, __REPO__, __HOME__ are filled in).
[Unit]
Description=ApplyPilot: find jobs, tailor resumes, refresh shortlist.csv
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO__
Environment=HOME=__HOME__
Environment=PYTHONUNBUFFERED=1
# Wider terminal so Rich tables in the journal aren't squashed.
Environment=COLUMNS=160
# Optional overrides (bucket, schedule options...) live here; ~/.applypilot/.env is also read.
EnvironmentFile=-/etc/default/applypilot
ExecStart=__REPO__/.venv/bin/applypilot cycle $APPLYPILOT_CYCLE_ARGS
# A full crawl + LLM scoring can take hours on the Gemini free tier. Searching is
# capped by time_budget_minutes; this is a safety net for the whole run.
TimeoutStartSec=10h
Nice=10
